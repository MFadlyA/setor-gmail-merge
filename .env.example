# ========================================================
# SETOR GMAIL WINTER - ENVIRONMENT CONFIGURATION
# ========================================================
# Salin file ini menjadi .env.local:
#   copy .env.example .env.local
# Dan isi nilai kredensial di bawah ini.

# 1. Supabase Database & Auth (Wajib)
# Ambil dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://kdjoeeehyahdgwgsfyal.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 2. Admin Whitelist (Wajib untuk akses portal /admin)
# Pisahkan dengan koma jika lebih dari satu email admin
ADMIN_EMAILS=komangabiw@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=komangabiw@gmail.com

# 3. Telegram Bot Notifications (Opsional, untuk laporan tiket & alert keamanan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1003715736899

# 4. Site URL (Opsional untuk redirect OAuth lokal)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 5. Custom Google OAuth (Opsional - agar layar login Google menampilkan domain setorgmail.com, bukan *.supabase.co)
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# 6. DANA Disbursement to Balance (Server-Only — JANGAN gunakan prefix NEXT_PUBLIC_)
# Gunakan huruf kecil untuk DANA_ENV: sandbox | production
DANA_ENV=sandbox
DANA_X_PARTNER_ID=
DANA_CLIENT_SECRET=
# Private key RSA merchant (satu baris dengan \n literal; jangan gunakan path file di Cloudflare Workers)
DANA_PRIVATE_KEY=
# Public key gateway milik DANA untuk verifikasi webhook /api/dana/finish-notify (wajib diisi saat production)
DANA_PUBLIC_KEY=
# Merchant ID DANA untuk cek saldo Merchant Disbursement Account (MDA)
DANA_MERCHANT_ID=
DANA_ORIGIN=https://www.setorgmail.com
DANA_DEBUG=true
